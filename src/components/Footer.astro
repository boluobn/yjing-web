---
import { ui, CONTACT_EMAIL, type Locale } from "@/content/i18n";
import Icon from "@/components/Icon.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const isZh = locale === "zh";

const privacyUrl = isZh
  ? "https://boluobn.github.io/yjing-doc/privacy/ios/privacy-policy.zh-Hans.html"
  : "https://boluobn.github.io/yjing-doc/privacy/ios/privacy-policy.en.html";
const termsUrl = "https://www.apple.com/legal/internet-services/itunes/dev/stdeula";
---
<footer class="border-t border-white/5 bg-black/40">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div class="flex items-center gap-3">
        <Icon size={36} class="rounded-[9px] shadow-lg" />
        <div>
          <div class="text-sm font-medium text-white/90">忆境空间 · YJing</div>
          <div class="text-xs text-white/50">{t.footer.tagline}</div>
        </div>
      </div>

      <div class="flex flex-col gap-3 md:items-end">
        <div class="flex items-center gap-2 text-xs text-white/65">
          <span class="text-white/40">{t.footer.contact}:</span>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="font-medium text-amber-300/90 transition hover:text-amber-200"
          >{CONTACT_EMAIL}</a>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-white/55 md:justify-end">
          <a
            href={isZh ? "/en/" : "/"}
            data-lang-set={isZh ? "en" : "zh"}
            class="transition hover:text-white"
          >{isZh ? "English" : "简体中文"}</a>
          <a href={privacyUrl} target="_blank" rel="noopener" class="transition hover:text-white">{t.footer.privacy}</a>
          <a href={termsUrl} target="_blank" rel="noopener" class="transition hover:text-white">{t.footer.terms}</a>
          <span class="text-white/30">{t.footer.copyright}</span>
        </div>
      </div>
    </div>
  </div>
</footer>
