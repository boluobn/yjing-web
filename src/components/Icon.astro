---
import { Image } from "astro:assets";
import iconSrc from "@/assets/icon.png";

interface Props {
  class?: string;
  size?: number;
}
const { class: className = "", size = 28 } = Astro.props;
---
<Image
  src={iconSrc}
  alt="YJing"
  width={size}
  height={size}
  widths={[size, size * 2, size * 3]}
  densities={[1, 2, 3]}
  class={className}
  loading="eager"
/>
