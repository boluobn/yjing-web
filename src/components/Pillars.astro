---
import { ui, type Locale } from "@/content/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];

const pillars = [
  { key: "reel", icon: "▶︎", accent: "from-orange-400/20 to-amber-500/10" },
  { key: "privacy", icon: "🔒", accent: "from-amber-300/15 to-yellow-400/5" },
  { key: "space", icon: "◉", accent: "from-orange-500/20 to-amber-300/10" },
  { key: "one_app", icon: "♾️", accent: "from-amber-400/20 to-orange-500/10" },
] as const;
---
<section id="pillars" class="relative px-5 py-24 md:py-32">
  <div class="mx-auto max-w-6xl">
    <h2 class="reveal mx-auto max-w-3xl text-balance text-center text-3xl font-semibold tracking-tight md:text-5xl">
      {t.pillars.heading}
    </h2>

    <div class="reveal mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => {
        const data = t.pillars[p.key];
        return (
          <article class={`group relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br ${p.accent} p-7 transition hover:border-white/25`}>
            <div class="glass absolute inset-0 -z-10"></div>
            <div class="text-3xl text-amber-400/90">{p.icon}</div>
            <h3 class="mt-6 text-xl font-semibold text-white">{data.title}</h3>
            <p class="mt-3 text-[14.5px] leading-relaxed text-white/65">{data.body}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
