---
import { Image } from "astro:assets";
import { ui, type Locale } from "@/content/i18n";
// Hero: 带 Inspector 的 mac-02（功能更丰富）
// 底部 mosaic 首张: 无 Inspector 的 mac-01
import m1 from "@/assets/screenshots/mac/mac-02.png";
import m2 from "@/assets/screenshots/mac/mac-01.png";
import m3 from "@/assets/screenshots/mac/mac-03.png";
import m4 from "@/assets/screenshots/mac/mac-04.png";
import m5 from "@/assets/screenshots/mac/mac-05.png";
import m6 from "@/assets/screenshots/mac/mac-06.png";
// mac-10 = 截屏2026-04-27 15.08.02.png — standalone preview window with toolbar + filmstrip,
// matches "系统级图片视频查看器" feature better than the previous mac-08.
import m8 from "@/assets/screenshots/mac/mac-10.png";
import m11 from "@/assets/screenshots/mac/mac-11.png";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale].mac;
const isZh = locale === "zh";
---
<section id="mac" class="relative px-5 py-24 md:py-32">
  <div class="mx-auto max-w-6xl">
    <header class="reveal max-w-3xl">
      <p class="text-[12px] font-medium uppercase tracking-[0.28em] text-amber-400/80">{t.eyebrow}</p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight md:text-5xl">{t.title}</h2>
      <p class="mt-5 text-balance text-[15.5px] leading-relaxed text-white/65 md:text-lg">{t.body}</p>
    </header>

    <!-- hero Mac screenshot -->
    <div class="reveal mt-14">
      <div class="relative">
        <div class="absolute -inset-x-12 -inset-y-8 -z-10 rounded-[3rem] bg-gradient-to-br from-amber-500/18 via-orange-400/8 to-transparent blur-2xl"></div>
        <div class="device-shadow overflow-hidden rounded-2xl border border-white/10 bg-black ring-1 ring-white/5">
          <Image src={m1} alt="" widths={[900, 1400, 1900]} sizes="(min-width:1024px) 1100px, 100vw" class="block h-auto w-full" />
        </div>
      </div>
    </div>

    <!-- system viewer hero feature -->
    <div class="reveal mt-20 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-[11.5px] font-medium uppercase tracking-[0.24em] text-amber-400/80">{t.hero_feature.subtitle}</p>
        <h3 class="mt-3 max-w-md text-balance text-2xl font-semibold tracking-tight md:text-4xl">{t.hero_feature.title}</h3>
        <p class="mt-5 max-w-lg text-[14.5px] leading-relaxed text-white/65 md:text-base">{t.hero_feature.body}</p>
        <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[12.5px] text-white/70">
          <span class="text-amber-400">⌃</span>
          <span>{isZh ? "Finder → 显示简介 → 打开方式 → 忆境空间 → 全部更改" : "Finder → Get Info → Open With → YJing → Change All…"}</span>
        </div>
      </div>
      <div class="device-shadow overflow-hidden rounded-2xl border border-white/10 bg-black ring-1 ring-white/5">
        <Image src={m8} alt="" widths={[700, 1200]} sizes="(min-width:1024px) 600px, 100vw" class="block h-auto w-full" loading="lazy" />
      </div>
    </div>

    <!-- features grid -->
    <div class="reveal mt-20 grid gap-3.5 md:grid-cols-2 lg:grid-cols-3">
      {t.features.map((f) => (
        <div class="rounded-2xl border border-white/8 bg-white/[0.03] p-5 transition hover:border-white/20 hover:bg-white/[0.05]">
          <h3 class="text-base font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-[13.5px] leading-relaxed text-white/60">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- Mac screenshot mosaic -->
    <div class="reveal mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[m2, m3, m4, m5, m6, m11].map((s) => (
        <div class="device-shadow overflow-hidden rounded-xl border border-white/8 bg-black ring-1 ring-white/5">
          <Image src={s} alt="" widths={[500, 900]} sizes="(min-width:1024px) 33vw, 50vw" class="block h-auto w-full" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>
