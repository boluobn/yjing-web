---
import { Image } from "astro:assets";
import { ui, type Locale, APP_STORE_VISION_URL } from "@/content/i18n";
import v1 from "@/assets/screenshots/visionpro/vision-1.png";
import v2 from "@/assets/screenshots/visionpro/vision-2.png";
import v3 from "@/assets/screenshots/visionpro/vision-3.png";
import vp from "@/assets/screenshots/mac/vision-pro-decoration.png";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale].vision;
const isZh = locale === "zh";
---
<section id="vision" class="relative overflow-hidden px-5 py-24 md:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-0 top-1/3 h-[700px] w-[900px] rounded-full bg-[radial-gradient(closest-side,rgba(217,116,40,0.15),transparent)] blur-3xl"></div>
    <div class="absolute right-0 bottom-0 h-[600px] w-[700px] rounded-full bg-[radial-gradient(closest-side,rgba(255,107,53,0.12),transparent)] blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl">
    <header class="reveal max-w-3xl">
      <p class="text-[12px] font-medium uppercase tracking-[0.28em] text-amber-400/80">{t.eyebrow}</p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight md:text-6xl">{t.title}</h2>
      <p class="mt-5 max-w-2xl text-balance text-[15.5px] leading-relaxed text-white/65 md:text-lg">{t.body}</p>
    </header>

    <!-- hero video -->
    <div class="reveal mt-14">
      <div class="relative mx-auto max-w-5xl">
        <div class="absolute -inset-x-10 -inset-y-8 -z-10 rounded-[3rem] bg-gradient-to-br from-amber-500/15 via-orange-500/8 to-transparent blur-2xl"></div>
        <div class="device-shadow overflow-hidden rounded-[2rem] border border-white/10 bg-black ring-1 ring-white/5">
          <video
            class="block h-auto w-full"
            src="/yjing-vision-en.mp4"
            poster=""
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="YJing Vision Pro demo"
          ></video>
        </div>
      </div>
    </div>

    <!-- screenshot trio -->
    <div class="reveal mt-10 grid gap-4 md:grid-cols-3">
      {[v1, v2, v3].map((s) => (
        <div class="device-shadow overflow-hidden rounded-xl border border-white/10 bg-black ring-1 ring-white/5">
          <Image src={s} alt="" widths={[600, 1200]} sizes="(min-width:768px) 33vw, 100vw" class="block h-auto w-full" loading="lazy" />
        </div>
      ))}
    </div>

    <!-- features -->
    <div class="reveal mt-16 grid gap-3.5 md:grid-cols-2">
      {t.features.map((f) => (
        <div class="rounded-2xl border border-white/8 bg-white/[0.03] p-6 transition hover:border-white/20 hover:bg-white/[0.05]">
          <h3 class="text-base font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-[14px] leading-relaxed text-white/60">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- device decoration + direct link -->
    <div class="reveal mt-16 flex flex-col items-center gap-6 text-center">
      <Image src={vp} alt="Apple Vision Pro" widths={[280, 560]} sizes="280px" class="h-auto w-[220px] opacity-90" loading="lazy" />
      <a
        href={APP_STORE_VISION_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-[13.5px] text-white/85 transition hover:border-white/40 hover:text-white"
      >
        {isZh ? "在 App Store 直接打开 Vision 版" : "Open Vision version on the App Store"}
        <span class="text-amber-400">→</span>
      </a>
    </div>
  </div>
</section>
