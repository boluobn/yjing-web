---
import { Image } from "astro:assets";
import { ui, type Locale } from "@/content/i18n";
import reel1 from "@/assets/screenshots/iphone/iphone-reel-1.jpeg";
import reel2 from "@/assets/screenshots/iphone/iphone-reel-2.jpeg";
import reel3 from "@/assets/screenshots/iphone/iphone-reel-3.jpeg";
import reel4 from "@/assets/screenshots/iphone/iphone-reel-4.jpeg";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---
<section class="relative overflow-hidden px-5 py-24 md:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/4 top-1/2 h-[600px] w-[800px] -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(255,107,53,0.18),transparent)] blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
    <!-- copy -->
    <div class="reveal">
      <p class="text-[12px] font-medium uppercase tracking-[0.28em] text-amber-400/80">
        {t.reel_showcase.eyebrow}
      </p>
      <h2 class="mt-5 max-w-xl text-balance text-3xl font-semibold leading-[1.15] tracking-tight md:text-5xl">
        {t.reel_showcase.title}
      </h2>
      <p class="mt-6 max-w-xl text-[15.5px] leading-relaxed text-white/65 md:text-base">
        {t.reel_showcase.body}
      </p>
      <ul class="mt-8 grid gap-3 max-w-xl">
        {t.reel_showcase.bullets.map((b) => (
          <li class="flex items-start gap-3 text-[14.5px] text-white/80">
            <span class="mt-1 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-amber-400"></span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- visual: layered iPhone reel screenshots -->
    <div class="reveal relative h-[560px] md:h-[640px]">
      <div class="absolute -inset-x-8 inset-y-0 -z-10 rounded-[3rem] bg-gradient-to-tr from-amber-500/20 via-orange-500/10 to-transparent blur-2xl"></div>

      <div class="absolute left-[6%] top-[6%] w-[42%] rotate-[-8deg]">
        <div class="device-shadow overflow-hidden rounded-[2rem] border border-white/10 bg-black ring-1 ring-white/5">
          <Image src={reel1} alt="" widths={[300, 600]} sizes="40vw" class="block h-auto w-full" loading="lazy" />
        </div>
      </div>
      <div class="absolute right-[6%] top-[2%] w-[44%] rotate-[6deg]">
        <div class="device-shadow overflow-hidden rounded-[2rem] border border-white/10 bg-black ring-1 ring-white/5 ring-amber-glow">
          <Image src={reel2} alt="" widths={[300, 600]} sizes="40vw" class="block h-auto w-full" loading="lazy" />
        </div>
      </div>
      <div class="absolute left-[20%] bottom-[2%] w-[44%] -rotate-[3deg]">
        <div class="device-shadow overflow-hidden rounded-[2rem] border border-white/10 bg-black ring-1 ring-white/5">
          <Image src={reel3} alt="" widths={[300, 600]} sizes="40vw" class="block h-auto w-full" loading="lazy" />
        </div>
      </div>
      <div class="absolute right-[2%] bottom-[14%] w-[36%] rotate-[10deg]">
        <div class="device-shadow overflow-hidden rounded-[2rem] border border-white/10 bg-black ring-1 ring-white/5">
          <Image src={reel4} alt="" widths={[260, 520]} sizes="36vw" class="block h-auto w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
