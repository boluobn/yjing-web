---
import { ui, type Locale, APP_STORE_UNIVERSAL_URL, APP_STORE_VISION_URL } from "@/content/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const isZh = locale === "zh";
---
<section class="relative overflow-hidden px-5 py-28 md:py-36">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-1/2 h-[800px] w-[1200px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(217,116,40,0.20),transparent)] blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-5xl text-center">
    <p class="text-[12px] font-medium uppercase tracking-[0.32em] text-amber-400/85">
      {t.universal.eyebrow}
    </p>

    <h2 class="reveal mt-6 text-balance text-4xl font-semibold leading-[1.05] tracking-tight md:text-7xl">
      <span class="text-gradient-amber">{t.universal.title}</span>
    </h2>

    <p class="reveal mx-auto mt-7 max-w-2xl text-balance text-base text-white/70 md:text-lg">
      {t.universal.body}
    </p>

    <!-- device row icons -->
    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-[13px] text-white/60">
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl border border-white/10 bg-white/5 text-base">📱</span>
        iPhone
      </div>
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl border border-white/10 bg-white/5 text-base">📲</span>
        iPad
      </div>
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl border border-white/10 bg-white/5 text-base">💻</span>
        Mac
      </div>
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl border border-white/10 bg-white/5 text-base">◉</span>
        Vision Pro
      </div>
    </div>

    <p class="mt-10 text-[12.5px] tracking-wider text-white/40">
      {t.universal.requirements}
    </p>

    <!-- CTA -->
    <div class="reveal mt-14 flex flex-col items-center gap-4">
      <h3 class="max-w-2xl text-balance text-2xl font-semibold tracking-tight md:text-3xl">{t.cta.title}</h3>
      <p class="max-w-xl text-[14.5px] text-white/55">{t.cta.body}</p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href={APP_STORE_UNIVERSAL_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-black shadow-lg shadow-amber-900/30 transition hover:scale-[1.02] hover:bg-[#f0a060]"
        >
          <span class="text-lg leading-none"></span>
          {t.cta.app_store_alt}
        </a>
        <a
          href={APP_STORE_VISION_URL}
          target="_blank"
          rel="noopener"
          class="rounded-full border border-white/20 px-6 py-3 text-sm font-medium text-white/85 transition hover:border-white/50 hover:text-white"
        >
          {t.cta.vision_link}
        </a>
      </div>
    </div>
  </div>
</section>
