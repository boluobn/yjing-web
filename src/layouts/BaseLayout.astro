---
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import type { Locale } from "@/content/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const lang = locale === "zh" ? "zh-CN" : "en";
const altLink = locale === "zh" ? "/en/" : "/";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={altLink} />
    <link rel="canonical" href={Astro.url.href} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!--
      Auto language detection (runs synchronously in <head> before body paints).
      Logic:
        1. localStorage 'yjing-lang' (user's manual override) wins.
        2. Otherwise: zh-CN / zh-Hans browser → /, everything else → /en/.
        3. zh-TW / zh-HK / zh-Hant → falls into "everything else" per user spec.
      Use location.replace() so back button doesn't loop.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('yjing-lang');
          var path = location.pathname;
          var onEn = /^\/en(\/|$)/.test(path);
          var preferZh;

          if (stored === 'zh') preferZh = true;
          else if (stored === 'en') preferZh = false;
          else {
            var langs = navigator.languages || [navigator.language || 'en'];
            preferZh = langs.some(function (l) {
              // Simplified Chinese only: zh-CN, zh-Hans, or bare 'zh' (most browsers expand to zh-CN).
              // Excludes zh-TW, zh-HK, zh-Hant per spec.
              return /^zh(-cn|-hans)?\b/i.test(l);
            });
          }

          if (preferZh && onEn) location.replace('/');
          else if (!preferZh && !onEn) location.replace('/en/');
        } catch (_) {
          // localStorage / navigator failure (rare) — silently keep current page.
        }
      })();
    </script>
  </head>
  <body class="font-sans">
    <Nav locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // IntersectionObserver for reveal animations — vanilla, ~30 lines
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -10% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Persist user's manual language choice. Any <a data-lang-set="zh|en"> click
      // writes to localStorage so the auto-detect script in <head> respects it
      // on subsequent visits.
      document.querySelectorAll<HTMLAnchorElement>("a[data-lang-set]").forEach((a) => {
        a.addEventListener("click", () => {
          const v = a.dataset.langSet;
          if (v === "zh" || v === "en") {
            try { localStorage.setItem("yjing-lang", v); } catch {}
          }
        });
      });
    </script>
  </body>
</html>
